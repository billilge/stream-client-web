# K-CONNECT에 등록한 앱의 client_id (K-계정 관리 페이지의 OAuth2 애플리케이션)
# 복사해서 .env로 만들고 값을 채운다 — .env는 커밋하지 않는다.
# 허가된 Redirect URI에 http://localhost:5173/oauth/kconnect(개발)와 배포 주소의 /oauth/kconnect가 등록돼 있어야 한다.
VITE_KCONNECT_CLIENT_ID=

# stream-server 주소(예: https://dev-api.stream.billilge.site). 배포 빌드에서만 채운다.
# 로컬 개발은 비워 둔다 — 요청이 개발 서버 주소로 나가고 아래 API_PROXY_TARGET으로 넘어간다.
VITE_API_BASE_URL=

# 로컬 개발 서버가 `/v1/...` 요청을 넘길 stream-server 주소(예: https://dev-api.stream.billilge.site).
# 개발 서버만 쓰는 값이라 VITE_를 붙이지 않는다(번들에 들어가지 않는다).
API_PROXY_TARGET=
